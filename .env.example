# Copy this file to .env (git-ignored) and paste your FREE keys. One key per provider; never rotate keys to dodge quotas.
# Groq free tier (no card):          https://console.groq.com/keys
GROQ_API_KEY=
# Google AI Studio free tier:        https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Optional (disabled in config.yaml by default)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Local models need no key: install Ollama (https://ollama.com) and keep it running.
